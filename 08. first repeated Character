class Solution {
    static int repeatedCharacter(String s) {
        HashSet<Character> set=new HashSet<>();
        int ans=-1;
        for(int i=s.length()-1;i>=0;i--){
        char ch=s.charAt(i);
        if(set.contains(ch)){
            ans=i;
        }
        set.add(ch);
        
       }
      return ans;
    }
}
