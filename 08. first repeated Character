class Solution {
    static int repeatedCharacter(String s) {
        int[] freq = new int[26];

        for (int i = 0; i < s.length(); i++) {
            int index = s.charAt(i) - 'a';

            if (freq[index] > 0) {
                return getFirstIndex(s, s.charAt(i));
            }

            freq[index]++;
        }

        return -1;
    }

    static int getFirstIndex(String s, char ch) {
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == ch) {
                return i;
            }
        }
        return -1;
    }
}
