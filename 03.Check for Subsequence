Input: s1 = "AXY", s2 = "YADXCP"
Output: false
Input: s1 = "gksrek", s2 = "geeksforgeeks"
Output: true
class Solution {
    public boolean isSubSeq(String s1, String s2) {
        int m=s1.length();
        int n=s2.length();
        int j=0;
        for(int i=0;i<n && j<m;i++){
            if(s2.charAt(i)==s1.charAt(j))
            j++;
        }
        return j==m;
        
    }
}
