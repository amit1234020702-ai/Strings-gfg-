Time: O(n)
Space: O(1)
class Solution {
    public boolean isIsogram(String s) {
        boolean[] seen = new boolean[256];

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (seen[ch]) {
                return false;
            }

            seen[ch] = true;
        }

        return true;
    }
}
