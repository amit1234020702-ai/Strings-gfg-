Input: s = "aabbbcc"
Output: 1
Input: s = "aaaaa"
Output: 2

class Solution {
    public int modified(String s) {
        int count = 1;
        int ans = 0;

        for (int i = 1; i < s.length(); i++) {

            if (s.charAt(i) == s.charAt(i - 1)) {
                count++;
            } else {
                count = 1;
            }

            if (count == 3) {
                ans++;
                count = 1;
            }
        }

        return ans;
    }
}
