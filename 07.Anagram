Input: s1 = "allergy", s2 = "allergyy" 
Output: false 

Input: s1 = "listen", s2 = "lists" 
Output: false 
class Solution {
    public static boolean areAnagrams(String s1, String s2) {
        // // code here
        // if(s1.length() !=s2.length()){   yt link=https://www.youtube.com/watch?v=rpZ3RRinBRM
        //     return false;
        // }
        // int [] freq=new int[26];
        // for(int i=0;i<s1.length();i++){
        //     freq[s1.charAt(i)-'a']++;
        //     freq[s2.charAt(i)-'a']--;
        // }
        // for(int count :freq){
        //     if(count!=0){
        //         return false;
        //     }
        // }
        // return true;
        
        
          if (s1.length() != s2.length()) {
            return false;
        }
         HashMap<Character, Integer> map = new HashMap<>();
          for (int i = 0; i < s1.length(); i++) {
            char ch = s1.charAt(i);

            if (map.containsKey(ch)) {
                map.put(ch, map.get(ch) + 1);
            } else {
                map.put(ch, 1);
            }
        }
         for (int i = 0; i < s2.length(); i++) {
            char ch = s2.charAt(i);

            if (!map.containsKey(ch)) {
                return false;
            }

            map.put(ch, map.get(ch) - 1);

            if (map.get(ch) == 0) {
                map.remove(ch);
            }
        }
          return map.isEmpty();
         
    }
}
