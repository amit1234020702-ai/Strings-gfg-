class Solution {
    public int countBinarySubstrings(String s) {
        // int count=0;
        // int ans=0;
        // for(int i=0;i<s.length();i++){
        //     if(s.charAt(i)=='1'){
        //         ans=ans+count;
        //         count++;
        //     }
        // }
        // return ans;

        int prev=0;
        int curr=1;
        int ans=0;
        for(int i=1;i<s.length();i++){
            if(s.charAt(i)==s.charAt(i-1)){
                curr++;
            }else{
                ans=ans+Math.min(prev,curr);
                prev=curr;
                curr=1;
            }
        }
        ans=ans+Math.min(prev,curr);
        return ans;
    }
}
